    given-names: Blaise
    email: blaise@ubik.studio
    website: https://blaiseab.com
license: Apache-2.0
repository-code: "https://github.com/random-walks/citeformer"
url: "https://citeformer.readthedocs.io"
version: 0.3.1
date-released: 2026-04-27
keywords:
  - large-language-models
  - retrieval-augmented-generation
  - constrained-decoding
  - citation-verification
  - structured-output
  - hallucination-mitigation
